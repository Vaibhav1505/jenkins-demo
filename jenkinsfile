pipeline {
    agent any
    stages {
        stage('Check Node version') {
            steps {
                sh 'node --version'
            }
        }
        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }
        stage('Build React App') {
            steps {
                sh 'npm run build'
            }
        }
    }
    post {
        always {
            echo 'Pipeline Completed'
        }
    }
}
